# API 服务端口
API_PORT=3001

# CORS 跨域配置
# 开发环境: * (允许所有来源)
# 生产环境: 必须指定具体域名，多个域名用逗号分隔
# 示例: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=*

# 数据库连接
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relax_git_dev

# Redis 连接
REDIS_URL=redis://localhost:6379

# Worker 健康检查地址
# Docker/OrbStack Compose 内默认使用 http://worker:3002/health；本机直跑 API 时可改为 http://localhost:3002/health
WORKER_HEALTH_URL=http://localhost:3002/health

# JWT 认证配置
# 生成强密钥: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# 账户安全配置
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=30
AUTH_ATTEMPT_WINDOW_MINUTES=15

# Git 代理设置 (可选)
# Docker/OrbStack 容器内不要使用 127.0.0.1；如需走宿主机代理，请使用 http://host.docker.internal:7899
GIT_HTTP_PROXY=
GIT_HTTPS_PROXY=
GIT_REMOTE_TIMEOUT_MS=180000
GIT_REMOTE_HEAD_TIMEOUT_MS=90000

# 日志级别
LOG_LEVEL=info

# DeepSeek AI 配置（仓库发现助手）
# 获取 API Key: https://platform.deepseek.com/api_keys
# 如果不配置，AI 功能将被禁用
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key-here
