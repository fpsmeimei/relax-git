# API 服务端口
API_PORT=3001

# CORS 跨域配置
# 开发环境: * (允许所有来源)
# 生产环境: 必须指定具体域名，多个域名用逗号分隔
# 示例: https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=*

# 数据库连接
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/relax_git_dev

# Redis 连接
REDIS_URL=redis://localhost:6379

# JWT 认证配置
# 生成强密钥: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# 账户安全配置
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=30
AUTH_ATTEMPT_WINDOW_MINUTES=15

# Git 代理设置 (仅在导入 GitHub 仓库时需要)
# 如果不需要导入 GitHub 仓库，可以不配置
GIT_HTTP_PROXY=http://127.0.0.1:7899
GIT_HTTPS_PROXY=http://127.0.0.1:7899
GIT_REMOTE_TIMEOUT_MS=180000
GIT_REMOTE_HEAD_TIMEOUT_MS=90000

# 日志级别
LOG_LEVEL=info

# 智谱 AI 配置
# 获取 API Key: https://open.bigmodel.cn/usercenter/apikeys
# 如果不配置，AI 功能将被禁用
ZHIPU_API_KEY=your-zhipu-api-key-here
