// Relax-Git 数据库 Schema
// 基于 PostgreSQL 16 + Prisma ORM
// 应届生学习项目版本：简化设计，重点学习数据库基础
// 最后更新：2025-01-11 - 新增代码差异对比功能

generator client {
  provider = "prisma-client-js"
  output   = "../../../libs/shared/src/generated/prisma-client"
}

// 评论点赞表（长期保留点赞数据，按用户+评论唯一）
model CommentLike {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  // 关联关系
  comment Comment @relation("CommentLikes", fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
  @@map("comment_likes")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  uid       String   @unique
  password  String   // bcrypt 哈希
  avatar    String?  // 头像 URL
  role      UserRole @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联关系
  ownedRepositories Repository[] @relation("RepositoryOwner")


  comments          Comment[]    @relation("CommentAuthor")
  timelineEvents    TimelineEvent[] @relation("TimelineActor")
  sessions          UserSession[]
  searchHistory     SearchHistory[] @relation("UserSearchHistory")
  commentLikes      CommentLike[]
  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("UserNotificationsActor")
  // 新增反向关系
  members           Member[]
  joinRequests      JoinRequest[]
  // 聊天系统反向关系
  chatMemberships   ChatMember[]
  messagesSent      Message[]
  // 社区化新增关联
  sessionSnapshots  SessionSnapshot[] @relation("UserSessionSnapshots")
  repositoryLikes   RepositoryLike[]  @relation("UserRepositoryLikes")
  repositoryCollections RepositoryCollection[] @relation("UserRepositoryCollections")
  repositoryViews   RepositoryView[]  @relation("UserRepositoryViews")

  @@map("users")
}

// 用户角色枚举
enum UserRole {
  USER
  ADMIN
  MODERATOR

  @@map("user_roles")
}

// 用户会话表（学习项目版本：简化JWT管理）
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  // 关联关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// 仓库表
model Repository {
  id            String           @id @default(cuid())
  name          String
  gitUrl        String
  ownerId       String
  defaultBranch String           @default("main")
  visibility    RepositoryVisibility @default(PRIVATE)
  description   String?
  isActive      Boolean          @default(true)
  lastSyncAt    DateTime?
  // 社区化新增字段
  coverImage    String?          // 封面图片URL
  tags          String[]         // 标签数组
  language      String?          // 主要编程语言
  stars         Int              @default(0) // 点赞数缓存
  viewCount     Int              @default(0) // 浏览量缓存
  trendingScore Float            @default(0) // 热度分数（用于推荐排序）
  isPublished   Boolean          @default(false) // 是否发布到社区
  publishedAt   DateTime?        // 发布到社区的时间
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // 关联关系
  owner          User            @relation("RepositoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  timelineEvents TimelineEvent[] @relation("RepositoryTimeline")
  searchHistory  SearchHistory[] @relation("RepositorySearchHistory")
  // 新增关联
  members        Member[]
  joinRequests   JoinRequest[]
  notifications  Notification[]
  // 社区化新增关联
  branches       RepositoryBranch[] @relation("RepositoryBranches")
  baseSnapshots  BaseSnapshot[]   @relation("RepositoryBaseSnapshots")
  artifacts      SnapshotArtifact[] @relation("RepositoryArtifacts") // Phase 2: 工件关联
  likes          RepositoryLike[]  @relation("RepositoryLikes")
  collections    RepositoryCollection[] @relation("RepositoryCollections")
  views          RepositoryView[]  @relation("RepositoryViews")
  viewsAgg       RepositoryViewsAgg[] @relation("RepositoryViewsAgg")

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([visibility])
  @@map("repositories")
}

// 仓库成员表
model Member {
  id      String     @id @default(cuid())
  repoId  String
  userId  String
  role    MemberRole @default(MEMBER)
  createdAt DateTime @default(now())

  // 关联
  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repoId, userId])
  @@index([repoId])
  @@index([userId])
  @@map("members")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER

  @@map("member_roles")
}

// 仓库加入申请表
model JoinRequest {
  id        String             @id @default(cuid())
  repoId    String
  userId    String
  reason    String?
  status    JoinRequestStatus  @default(PENDING)
  createdAt DateTime           @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  // 关联
  repository Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@index([userId])
  @@index([status])
  @@map("join_requests")
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("join_request_status")
}

// 仓库可见性枚举（API 枚举保持大写，落库小写，便于前后端统一字符串）
enum RepositoryVisibility {
  PUBLIC   @map("public_all")       // 公开且可评论
  INTERNAL @map("public_readonly")  // 公开只读（仅成员/Owner可评，当前临时仅Owner）
  PRIVATE  @map("private")          // 私有

  @@map("repository_visibility")
}

// 仓库分支表（新增）
model RepositoryBranch {
  id         String   @id @default(cuid())
  repoId     String
  name       String   // 分支名称
  commitSha  String   // 最新提交SHA
  isDefault  Boolean  @default(false) // 是否为默认分支
  currentArtifactId String? @map("current_artifact_id") // Phase 2: 当前artifact引用
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 关联关系
  repository    Repository     @relation("RepositoryBranches", fields: [repoId], references: [id], onDelete: Cascade)
  baseSnapshots BaseSnapshot[] @relation("BranchBaseSnapshots")
  currentArtifact SnapshotArtifact? @relation("BranchCurrentArtifact", fields: [currentArtifactId], references: [id])

  @@unique([repoId, name])
  @@index([repoId])
  @@index([currentArtifactId])
  @@map("repository_branches")
}

// 基础快照表（统一快照模型）
model BaseSnapshot {
  id           String            @id @default(cuid())
  repoId       String
  branchId     String
  commitSha    String
  worktreePath String?           @map("worktree_path") // Git worktree 路径
  bundlePath   String?           @map("bundle_path") // Git bundle 存储路径
  status       BaseSnapshotStatus @default(QUEUED)
  errorMessage String?           @map("error_message") // 错误信息


  lastAccessedAt DateTime        @default(now()) @map("last_accessed_at") // 最后访问时间
  accessCount  Int               @default(0) @map("access_count") // 访问计数

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  processedAt  DateTime?         // 处理完成时间

  // 关联关系
  repository      Repository       @relation("RepositoryBaseSnapshots", fields: [repoId], references: [id], onDelete: Cascade)
  branch          RepositoryBranch @relation("BranchBaseSnapshots", fields: [branchId], references: [id], onDelete: Cascade)

  sessionSnapshots SessionSnapshot[] @relation("BaseSessionSnapshots")

  comments        Comment[]     @relation("BaseSnapshotComments")
  timelineEvents  TimelineEvent[] @relation("BaseSnapshotTimeline")
  searchHistory   SearchHistory[] @relation("BaseSnapshotSearchHistory")

  @@unique([repoId, branchId]) // 每个分支只有一个基础快照
  @@index([repoId])
  @@index([branchId])
  @@index([status])

  @@index([lastAccessedAt])
  @@index([commitSha])
  @@map("base_snapshots")
}

// 会话快照表（新增）
model SessionSnapshot {
  id             String               @id @default(cuid())
  baseSnapshotId String
  userId         String
  worktreePath   String?              @map("worktree_path") // Git worktree 路径
  status         SessionSnapshotStatus @default(CREATING)
  expiresAt      DateTime             // TTL 过期时间
  lastAccessedAt DateTime             @default(now()) @map("last_accessed_at")
  errorMessage   String?              @map("error_message") // 错误信息
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  // 关联关系
  baseSnapshot BaseSnapshot @relation("BaseSessionSnapshots", fields: [baseSnapshotId], references: [id], onDelete: Cascade)
  user         User         @relation("UserSessionSnapshots", fields: [userId], references: [id], onDelete: Cascade)

  @@index([baseSnapshotId])
  @@index([userId])
  @@index([expiresAt])
  @@index([lastAccessedAt])
  @@map("session_snapshots")
}

// 基础快照状态枚举
enum BaseSnapshotStatus {
  QUEUED      // 队列中
  PROCESSING  // 处理中
  READY       // 就绪
  FAILED      // 失败

  @@map("base_snapshot_status")
}

// Phase 2: 快照工件表（commit级别复用）
model SnapshotArtifact {
  id           String            @id @default(cuid())
  repoId       String            @map("repo_id")
  commitSha    String            @map("commit_sha")
  status       ArtifactStatus    @default(QUEUED)
  worktreePath String?           @map("worktree_path")
  bundlePath   String?           @map("bundle_path")
  processedAt  DateTime?         @map("processed_at")
  errorMessage String?           @map("error_message")
  metadata     Json              @default("{}") // 额外元数据
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  // 关联关系
  repository Repository @relation("RepositoryArtifacts", fields: [repoId], references: [id], onDelete: Cascade)
  branches   RepositoryBranch[] @relation("BranchCurrentArtifact")

  @@unique([repoId, commitSha])
  @@index([repoId])
  @@index([commitSha])
  @@index([status])
  @@index([createdAt])
  @@map("snapshot_artifacts")
}

// 工件状态枚举
enum ArtifactStatus {
  QUEUED      // 队列中
  PROCESSING  // 处理中
  READY       // 就绪
  FAILED      // 失败

  @@map("artifact_status")
}

// 会话快照状态枚举
enum SessionSnapshotStatus {
  CREATING    // 创建中
  READY       // 就绪
  EXPIRED     // 已过期
  FAILED      // 失败

  @@map("session_snapshot_status")
}





// 评论表
model Comment {
  id         String        @id @default(cuid())
  snapshotId String
  authorId   String
  content    String        // Markdown 内容
  anchorType CommentAnchorType

  // 锚点信息
  commitSha  String?       // 提交级锚点
  filePath   String?       // 文件级锚点
  lineStart  Int?          // 行级锚点开始
  lineEnd    Int?          // 行级锚点结束

  status     CommentStatus @default(PUBLISHED)
  parentId   String?       // 回复评论的父评论ID
  isResolved Boolean       @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // 关联关系
  snapshot       BaseSnapshot    @relation("BaseSnapshotComments", fields: [snapshotId], references: [id], onDelete: Cascade)
  author         User        @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent         Comment?    @relation("CommentReplies", fields: [parentId], references: [id])
  replies        Comment[]   @relation("CommentReplies")
  timelineEvents TimelineEvent[] @relation("CommentTimeline")
  likes          CommentLike[]   @relation("CommentLikes")
  notifications  Notification[]  @relation("CommentNotifications")

  @@index([snapshotId])
  @@index([authorId])
  @@index([status])
  @@index([parentId])
  @@index([commitSha])
  @@index([filePath])
  @@map("comments")
}

// 评论锚点类型枚举
enum CommentAnchorType {
  SNAPSHOT  // 快照级评论
  PROJECT   // 项目级评论（社区化新增）
  COMMIT    // 提交级评论
  FILE      // 文件级评论
  LINE      // 行级评论

  @@map("comment_anchor_types")
}

// 评论状态枚举
enum CommentStatus {
  DRAFT     // 草稿
  ACTIVE    // 活跃（已发布）
  PUBLISHED // 已发布（兼容性保留）
  HIDDEN    // 已隐藏
  DELETED   // 已删除（软删除）

  @@map("comment_status")
}

// 时间线事件表
model TimelineEvent {
  id        String            @id @default(cuid())
  repoId    String
  type      TimelineEventType
  actorId   String

  // 关联资源ID（可选）
  snapshotId String?
  commentId  String?

  // 事件载荷（JSON）
  payload   Json

  createdAt DateTime          @default(now())

  // 关联关系
  repository Repository @relation("RepositoryTimeline", fields: [repoId], references: [id], onDelete: Cascade)
  actor      User       @relation("TimelineActor", fields: [actorId], references: [id], onDelete: Cascade)
  snapshot   BaseSnapshot?  @relation("BaseSnapshotTimeline", fields: [snapshotId], references: [id], onDelete: Cascade)
  comment    Comment?   @relation("CommentTimeline", fields: [commentId], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@index([actorId])
  @@index([type])
  @@index([createdAt])
  @@index([snapshotId])
  @@index([commentId])
  @@map("timeline_events")
}

// 时间线事件类型枚举
enum TimelineEventType {
  REPOSITORY_CREATED  // 仓库创建
  SNAPSHOT_CREATED    // 快照创建
  SNAPSHOT_READY      // 快照就绪
  SNAPSHOT_EXPIRED    // 快照过期
  COMMENT_CREATED     // 评论创建
  COMMENT_UPDATED     // 评论更新
  COMMENT_RESOLVED    // 评论解决
  USER_JOINED         // 用户加入

  @@map("timeline_event_types")
}






// 搜索历史表
model SearchHistory {
  id           String     @id @default(cuid())
  userId       String
  repositoryId String
  snapshotId   String?    // 可选：指定快照搜索
  query        String     // 搜索关键词
  searchType   SearchType @default(CONTENT) // 搜索类型
  resultsCount Int        @default(0)       // 结果数量
  createdAt    DateTime   @default(now())

  // 关联关系
  user       User       @relation("UserSearchHistory", fields: [userId], references: [id], onDelete: Cascade)
  repository Repository @relation("RepositorySearchHistory", fields: [repositoryId], references: [id], onDelete: Cascade)
  snapshot   BaseSnapshot?  @relation("BaseSnapshotSearchHistory", fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([repositoryId])
  @@index([createdAt])
  @@map("search_history")
}

// 搜索类型枚举
enum SearchType {
  CONTENT  // 文件内容搜索
  FILENAME // 文件名搜索
  REGEX    // 正则表达式搜索

  @@map("search_type")
}

// ===== 通知：用于“我的→通知”与被回复/@提及/系统事件 =====
enum NotificationType {
  COMMENT_REPLY        // 有人回复了你的评论
  MENTION              // 在评论中被 @ 提及
  JOIN_REQUEST_APPROVED // 加入申请通过（预留）
  JOIN_REQUEST_REJECTED // 加入申请被驳回（预留）

  @@map("notification_types")
}

model Notification {
  id         String            @id @default(cuid())
  userId     String            // 被通知人
  actorId    String            // 触发者（谁触发了通知）
  type       NotificationType
  commentId  String?           // 关联评论（回复/提及）；系统类通知可为空
  parentId   String?           // 被回复的父评论ID（回复时可用）
  snapshotId String?
  repoId     String?           // 关联仓库（系统通知跳转用）
  content    String?           // 展示文案："{actor}: {content摘要}"
  isRead     Boolean           @default(false)
  createdAt  DateTime          @default(now())

  // 关联关系
  user       User        @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor      User        @relation("UserNotificationsActor", fields: [actorId], references: [id], onDelete: Cascade)
  comment    Comment?    @relation("CommentNotifications", fields: [commentId], references: [id], onDelete: Cascade)
  repository Repository? @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([actorId])
  @@index([commentId])
  @@index([snapshotId])
  @@index([repoId])
  @@map("notifications")
}

// ===== 聊天系统（MVP） =====

/// 会话：私聊(DIRECT) 或 群聊(GROUP)
model Chat {
  id        String    @id @default(cuid())
  type      ChatType
  name      String?
  /// 私聊唯一键：由两个用户ID排序后拼接（如 userA:userB），群聊为空
  directKey String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 关联
  members ChatMember[]
  messages Message[]

  @@map("chats")
}

enum ChatType {
  DIRECT
  GROUP

  @@map("chat_type")
}

model ChatMember {
  id         String          @id @default(cuid())
  chatId     String
  userId     String
  role       ChatMemberRole  @default(MEMBER)
  lastReadAt DateTime?
  createdAt  DateTime        @default(now())

  // 关联
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([chatId])
  @@index([userId])
  @@map("chat_members")
}

enum ChatMemberRole {
  ADMIN
  MEMBER

  @@map("chat_member_roles")
}

model Message {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  // 关联
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@index([senderId])
  @@map("messages")
}

// 仓库点赞表（社区化新增）
model RepositoryLike {
  id        String   @id @default(cuid())
  repoId    String
  userId    String
  createdAt DateTime @default(now())

  // 关联关系
  repository Repository @relation("RepositoryLikes", fields: [repoId], references: [id], onDelete: Cascade)
  user       User       @relation("UserRepositoryLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repoId, userId]) // 一个用户只能对一个仓库点赞一次
  @@index([repoId])
  @@index([userId])
  @@index([createdAt])
  @@map("repository_likes")
}

// 仓库收藏表（社区化新增）
model RepositoryCollection {
  id        String   @id @default(cuid())
  repoId    String
  userId    String
  createdAt DateTime @default(now())

  // 关联关系
  repository Repository @relation("RepositoryCollections", fields: [repoId], references: [id], onDelete: Cascade)
  user       User       @relation("UserRepositoryCollections", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([repoId, userId]) // 一个用户只能收藏一个仓库一次
  @@index([repoId])
  @@index([userId])
  @@index([createdAt])
  @@map("repository_collections")
}

// 仓库浏览记录表（社区化新增）
model RepositoryView {
  id         String   @id @default(cuid())
  repoId     String
  userId     String?  // 可选，支持匿名浏览
  ipAddress  String?  // IP地址，用于匿名用户统计
  userAgent  String?  // 用户代理
  viewedAt   DateTime @default(now())

  // 关联关系
  repository Repository @relation("RepositoryViews", fields: [repoId], references: [id], onDelete: Cascade)
  user       User?      @relation("UserRepositoryViews", fields: [userId], references: [id], onDelete: Cascade)

  @@index([repoId])
  @@index([userId])
  @@index([viewedAt])
  @@index([ipAddress])
  @@map("repository_views")
}

// 仓库浏览量聚合表（用于热度计算）
model RepositoryViewsAgg {
  id         String   @id @default(cuid())
  repoId     String
  date       DateTime // 聚合日期（按天）
  viewCount  Int      @default(0) // 当日浏览量
  uniqueUsers Int     @default(0) // 当日独立用户数
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 关联关系
  repository Repository @relation("RepositoryViewsAgg", fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, date]) // 每个仓库每天只有一条聚合记录
  @@index([repoId])
  @@index([date])
  @@index([viewCount])
  @@map("repository_views_agg")
}
