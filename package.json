{
  "name": "relax-git",
  "version": "0.1.0",
  "description": "基于 Git worktree 的现代化协作平台",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "pnpm": {
    "overrides": {
      "react": "19.1.1",
      "react-dom": "19.1.1",
      "typescript": "5.9.2",
      "vite": "7.3.2",
      "jws": "3.2.3",
      "validator": "13.15.35",
      "fast-uri": "3.1.2",
      "socket.io-parser": "4.2.6",
      "picomatch@<2.3.2": "2.3.2",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "glob@>=11.0.0 <11.1.0": "11.1.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.5",
      "@isaacs/brace-expansion@<=5.0.0": "5.0.1",
      "lodash": "4.18.1",
      "rollup": "4.61.1",
      "serialize-javascript": "7.0.5",
      "flatted": "3.4.2",
      "handlebars": "4.7.9",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "tmp@<0.2.6": "0.2.7"
    }
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "docker:dev": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "health-check": "node tools/scripts/health-check.js",
    "setup": "pnpm install",
    "db:generate": "cd apps/api && pnpm db:generate",
    "db:setup": "node tools/scripts/db-setup.js setup",
    "db:reset": "node tools/scripts/db-setup.js reset",
    "db:studio": "node tools/scripts/db-setup.js studio",
    "temp:clean": "node tools/scripts/cleanup-temp.js cleanup",
    "temp:list": "node tools/scripts/cleanup-temp.js list",
    "lint:garbled": "node tools/scripts/lint-garbled.js",
    "lint:garbled:web": "node tools/scripts/lint-garbled.js apps/web/src",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/ui": "^4.1.8",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.2.0",
    "turbo": "^1.12.0",
    "typescript": "^5.9.2",
    "vite": "7.3.2",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "git",
    "collaboration",
    "worktree",
    "snapshot",
    "code-review"
  ],
  "author": "Relax-Git Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/schedule": "^6.0.1",
    "aws-sdk": "^2.1692.0",
    "cloudinary": "^2.7.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "react-easy-crop": "^5.5.2",
    "sonner": "^2.0.7"
  }
}
