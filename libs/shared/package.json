{
  "name": "@relax-git/shared",
  "version": "0.1.0",
  "description": "Relax-Git 共享类型和工具库",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generated/prisma-client": {
      "types": "./src/generated/prisma-client/index.d.ts",
      "default": "./src/generated/prisma-client/default.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "prisma": "^5.8.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
