# 数据库配置
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/relax_git_dev"
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=relax_git_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_TIMEOUT=30000

# Redis 配置
REDIS_URL="redis://localhost:6379/0"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# 安全配置
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION_MINUTES=30
AUTH_ATTEMPT_WINDOW_MINUTES=15
CORS_ORIGIN=http://localhost:3000

# 应用配置
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002

# S3/MinIO 配置
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=relax-git-snapshots
S3_REGION=us-east-1

# Git 配置
GIT_WORKTREE_BASE_PATH=/tmp/relax-git-worktrees
GIT_BUNDLE_BASE_PATH=/tmp/relax-git-bundles

# 快照配置
SNAPSHOT_BASE_PATH=/tmp/relax-git-sessions
SESSION_SNAPSHOT_TTL_MINUTES=60
ORPHAN_CLEANUP_ENABLED=true

# 性能配置
MAX_CONCURRENT_SNAPSHOTS=3
SNAPSHOT_TTL_DAYS=7
SNAPSHOT_CREATION_TIMEOUT=30
EVENT_PUSH_TIMEOUT=500

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# 监控配置
PROMETHEUS_PORT=9090
HEALTH_CHECK_PORT=8080
